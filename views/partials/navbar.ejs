<style>
/* ============================================
   NAVIGATION BAR — shares tokens with style.css;
   fallbacks included so this partial still looks
   correct if loaded on its own.
   ============================================ */

:root {
    --nav-height: 68px;
}

.dashboard-nav {
    background: rgba(20, 30, 48, 0.85);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: env(safe-area-inset-top);
}

/* Signature element — the same animated gradient used on the page title
   and the footer, so header and footer visually "frame" the page. */
.nav-glow-line {
    height: 3px;
    width: 100%;
    background: linear-gradient(90deg, #00d4ff, #7c3aed, #ff006e, #00d4ff);
    background-size: 300% 100%;
    animation: navGradientShift 6s ease infinite;
}

@keyframes navGradientShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: var(--nav-height);
    padding: 0 var(--space-4, 16px);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Brand */
.nav-brand a {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 700;
    border-radius: var(--radius-sm, 6px);
    transition: transform var(--duration-fast, 150ms) ease;
}

.nav-brand a:hover {
    transform: scale(1.02);
}

.nav-brand a:focus-visible {
    outline: 2px solid var(--color-accent, #00c6ff);
    outline-offset: 4px;
}

.brand-mark {
    display: flex;
    flex-shrink: 0;
}

.brand-text {
    color: #ffffff;
}

.brand-highlight {
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

/* Nav links */
.nav-links {
    display: flex;
    gap: var(--space-2, 8px);
}

.nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
    min-height: var(--touch-min, 44px);
    padding: var(--space-2, 8px) var(--space-4, 16px);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: var(--radius-md, 10px);
    transition: color var(--duration-fast, 150ms) ease, background var(--duration-fast, 150ms) ease, transform var(--duration-fast, 150ms) ease;
    position: relative;
}

.nav-icon {
    flex-shrink: 0;
}

/* RGB icon keeps its own brand colors at all times — it's a fixed
   identity mark for the "color" concept, not a state-driven icon */
.nav-icon-rgb {
    opacity: 1;
}

.nav-link:hover {
    color: #ffffff;
    background: rgba(0, 198, 255, 0.1);
    transform: translateY(-1px);
}

.nav-link:focus-visible {
    outline: 2px solid var(--color-accent, #00c6ff);
    outline-offset: 2px;
    color: #ffffff;
}

.nav-link.active {
    color: var(--color-accent, #00c6ff);
    background: rgba(0, 198, 255, 0.15);
}

.nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 2px;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    border-radius: 2px;
}

/* Mobile toggle button — sized to the 44x44 touch target minimum
   (was 30x25 before) */
.nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    gap: 5px;
    background: none;
    border: none;
    padding: 0;
    width: var(--touch-min, 44px);
    height: var(--touch-min, 44px);
    border-radius: var(--radius-sm, 6px);
    touch-action: manipulation;
}

.nav-toggle span {
    width: 24px;
    height: 2.5px;
    background: #ffffff;
    border-radius: 3px;
    transition: all var(--duration-fast, 150ms) ease;
}

.nav-toggle:hover span {
    background: var(--color-accent, #00c6ff);
}

.nav-toggle:focus-visible {
    outline: 2px solid var(--color-accent, #00c6ff);
    outline-offset: 2px;
}

/* Animate hamburger into an X when open */
.nav-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
}
.nav-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
}
.nav-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
}

/* Scrim behind the mobile menu */
.nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    z-index: 999;
    transition: opacity var(--duration-base, 250ms) ease;
}

.nav-scrim.active {
    opacity: 1;
    pointer-events: auto;
}

/* ============================================
   RESPONSIVE — matches style.css breakpoints (768)
   ============================================ */
@media (max-width: 768px) {
    .nav-toggle {
        display: flex;
    }

    .nav-links {
        position: fixed;
        top: calc(var(--nav-height) + env(safe-area-inset-top));
        left: 0;
        right: 0;
        width: 100%;
        background: rgba(20, 30, 48, 0.97);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        flex-direction: column;
        align-items: stretch;
        padding: var(--space-4, 16px);
        padding-bottom: calc(var(--space-4, 16px) + env(safe-area-inset-bottom));
        transform: translateY(-8px);
        opacity: 0;
        visibility: hidden;
        transition: transform var(--duration-base, 250ms) ease, opacity var(--duration-base, 250ms) ease, visibility var(--duration-base, 250ms);
        gap: var(--space-2, 8px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        max-height: calc(100dvh - var(--nav-height));
        overflow-y: auto;
    }

    .nav-links.active {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    .nav-link {
        justify-content: center;
        padding: var(--space-3, 12px);
    }

    .nav-link.active::after {
        bottom: 2px;
    }
}

@media (max-width: 480px) {
    .nav-container {
        padding: 0 12px;
    }

    .nav-brand a {
        font-size: 1.15rem;
        gap: 6px;
    }

    .brand-mark svg {
        width: 24px;
        height: 24px;
    }
}

/* Main content adjustment for fixed navbar */
.main-content {
    padding-top: calc(var(--nav-height) + env(safe-area-inset-top));
    min-height: 100vh;
    min-height: 100dvh;
}

@media (prefers-reduced-motion: reduce) {
    .nav-glow-line {
        animation: none;
    }

    .nav-links,
    .nav-toggle span,
    .nav-scrim {
        transition: none;
    }
}
</style>

<script>
// Mobile menu toggle functionality
document.addEventListener('DOMContentLoaded', function () {
    var navToggle = document.getElementById('navToggle');
    var navLinks = document.getElementById('navLinks');
    var navScrim = document.getElementById('navScrim');

    if (!navToggle || !navLinks) return;

    function openMenu() {
        navLinks.classList.add('active');
        if (navScrim) navScrim.classList.add('active');
        navToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        navLinks.classList.remove('active');
        if (navScrim) navScrim.classList.remove('active');
        navToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
    }

    navToggle.addEventListener('click', function () {
        var isOpen = navLinks.classList.contains('active');
        isOpen ? closeMenu() : openMenu();
    });

    // Close menu when clicking a link
    navLinks.querySelectorAll('.nav-link').forEach(function (link) {
        link.addEventListener('click', closeMenu);
    });

    // Close menu when clicking the scrim or outside the menu
    if (navScrim) navScrim.addEventListener('click', closeMenu);

    document.addEventListener('click', function (event) {
        if (!navToggle.contains(event.target) && !navLinks.contains(event.target)) {
            closeMenu();
        }
    });

    // Close menu on Escape for keyboard users
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && navLinks.classList.contains('active')) {
            closeMenu();
            navToggle.focus();
        }
    });
});
</script>
