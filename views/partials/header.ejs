<!-- Header Partial - Contains head section, meta tags, CSS, and fonts -->
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= title %></title>
    <meta name="description" content="Convert 8-bit binary values for Red, Green, and Blue channels into a live color preview with HEX output and color name detection." />
    <meta name="keywords" content="binary, color, rgb, generator, educational, express, nodejs, ejs" />
    <meta name="author" content="Binary Color Generator Team" />

    <!-- Matches the app's dark background so mobile browser chrome (status bar /
         address bar) doesn't clash with the UI -->
    <meta name="theme-color" content="#141e30" />

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="Convert binary to color - Educational tool for learning binary representation through digital colors." />
    <meta property="og:type" content="website" />

    <!-- Favicon (also used as the touch icon and the navbar brand mark, so the
         "01" motif stays consistent across browser tab, home screen, and nav) -->
    <link rel="icon" type="image/png" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%2300c6ff'/%3E%3Ctext x='50' y='70' font-size='60' text-anchor='middle' fill='white' font-family='monospace'%3E01%3C/text%3E%3C/svg%3E" />
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%23141e30'/%3E%3Ccircle cx='50' cy='50' r='40' fill='%2300c6ff'/%3E%3Ctext x='50' y='68' font-size='55' text-anchor='middle' fill='white' font-family='monospace'%3E01%3C/text%3E%3C/svg%3E" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Main Stylesheet -->
    <link rel="stylesheet" href="/style.css" />

    <!-- Conditional page-specific styles can be injected here -->
    <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
        <%- '<style>' + pageStyles + '</style>' %>
    <% } %>
</head>
