<!-- Interactive Hero Workbench Script -->
<script>
  (function () {
    const presetButtons = document.querySelectorAll('.hw-preset-btn');
    const swatch = document.getElementById('hwSwatch');
    const swatchGlow = document.getElementById('hwSwatchGlow');
    const colorNameEl = document.getElementById('hwColorName');
    const hexEl = document.getElementById('hwHex');
    const rgbEl = document.getElementById('hwRgb');
    const binary24El = document.getElementById('hwBinary24');
    const contrastEl = document.getElementById('hwContrast');

    const redDecEl = document.getElementById('hwRedDec');
    const greenDecEl = document.getElementById('hwGreenDec');
    const blueDecEl = document.getElementById('hwBlueDec');

    const redBar = document.getElementById('hwRedBar');
    const greenBar = document.getElementById('hwGreenBar');
    const blueBar = document.getElementById('hwBlueBar');

    const redBits = document.getElementById('hwRedBits');
    const greenBits = document.getElementById('hwGreenBits');
    const blueBits = document.getElementById('hwBlueBits');

    function renderBits(container, binaryStr) {
      if (!container) return;
      container.innerHTML = '';
      for (let i = 0; i < binaryStr.length; i++) {
        const span = document.createElement('span');
        span.className = 'bit' + (binaryStr[i] === '1' ? ' active' : '');
        span.textContent = binaryStr[i];
        container.appendChild(span);
      }
    }

    function hexToDec(bin) {
      return parseInt(bin, 2);
    }

    presetButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        presetButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const rBin = btn.getAttribute('data-r');
        const gBin = btn.getAttribute('data-g');
        const bBin = btn.getAttribute('data-b');
        const hex = btn.getAttribute('data-hex');
        const name = btn.getAttribute('data-name');
        const rgb = btn.getAttribute('data-rgb');
        const textColor = btn.getAttribute('data-text');

        const rDec = hexToDec(rBin);
        const gDec = hexToDec(gBin);
        const bDec = hexToDec(bBin);

        // Update swatch
        swatch.style.backgroundColor = hex;
        swatch.style.color = textColor;
        swatchGlow.style.background = 'radial-gradient(circle, ' + hex + '66 0%, transparent 70%)';

        colorNameEl.textContent = name;
        hexEl.textContent = hex;
        rgbEl.textContent = rgb;
        binary24El.textContent = rBin + ' ' + gBin + ' ' + bBin;

        contrastEl.textContent = textColor === '#000000' ? 'Dark Text (Optimal)' : 'Light Text (Optimal)';

        // Update channel numbers & bars
        redDecEl.textContent = rDec;
        greenDecEl.textContent = gDec;
        blueDecEl.textContent = bDec;

        redBar.style.width = ((rDec / 255) * 100) + '%';
        greenBar.style.width = ((gDec / 255) * 100) + '%';
        blueBar.style.width = ((bDec / 255) * 100) + '%';

        // Update bit tracks
        renderBits(redBits, rBin);
        renderBits(greenBits, gBin);
        renderBits(blueBits, bBin);
      });
    });
